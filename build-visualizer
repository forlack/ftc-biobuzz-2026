#!/bin/sh
# Build our fork of the Pedro Pathing visualizer (github.com/forlack/Visualizer) into
# dashboard/web/visualizer, where the dashboard's Paths tab serves it.
#
# Only needed after changing the visualizer: the built copy is committed, so using the
# dashboard needs no Node. Set VISUALIZER=/path/to/Visualizer to use another checkout.
set -e
cd "$(dirname "$0")"
SOURCE="${VISUALIZER:-../Visualizer}"
if [ ! -d "$SOURCE" ]; then
    git clone https://github.com/forlack/Visualizer.git "$SOURCE"
fi
(cd "$SOURCE" && npm ci --no-audit --no-fund && npx vite build)
rm -rf dashboard/web/visualizer
cp -r "$SOURCE/dist" dashboard/web/visualizer
echo "Built $(cd "$SOURCE" && git rev-parse --short HEAD) into dashboard/web/visualizer"
