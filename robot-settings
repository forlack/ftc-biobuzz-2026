#!/usr/bin/env python3
"""Copy robot.json (the tunable numbers) between the robot and settings/robot.json.

  ./robot-settings pull   robot -> repo, after saving from Panels (then commit it)
  ./robot-settings push   repo -> robot; the robot's old file becomes robot.json.bak

Connect to the robot Wi-Fi (or USB with -s SERIAL) first; this never switches networks.
No build or restart: the robot reads a changed robot.json at the next INIT.
"""
import argparse
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys

ROOT = Path(__file__).resolve().parent
LOCAL = ROOT / 'settings' / 'robot.json'
REMOTE = '/sdcard/FIRST/settings/robot.json'


def find_adb():
    properties = ROOT / 'local.properties'
    if properties.exists():
        for line in properties.read_text().splitlines():
            if line.startswith('sdk.dir='):
                candidate = Path(line.split('=', 1)[1].strip()) / 'platform-tools' / 'adb'
                if candidate.is_file():
                    return str(candidate)
    return shutil.which('adb')


def reject_constant(value):
    raise ValueError(f'Non-finite JSON number: {value}')


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument('direction', choices=['pull', 'push'])
    parser.add_argument('-s', '--serial', default=os.environ.get('ANDROID_SERIAL', '192.168.43.1:5555'),
                        help='ADB device serial; defaults to the robot Wi-Fi address')
    args = parser.parse_args()

    if args.direction == 'push':
        try:
            settings = json.loads(LOCAL.read_text(), parse_constant=reject_constant)
        except (OSError, ValueError) as error:
            parser.error(f'Cannot read valid JSON from {LOCAL}: {error}')
        if not isinstance(settings, dict) or settings.get('version') != 1:
            parser.error(f'{LOCAL} must be a JSON object with "version": 1.')

    adb = find_adb()
    if not adb:
        parser.error('ADB not found. Set up the Android SDK first.')

    def run(*arguments, check=True):
        return subprocess.run([adb, *arguments], check=check, timeout=30,
                              capture_output=True, text=True)

    # A fresh ADB server first: after switching Wi-Fi an old one often shows "offline".
    try:
        subprocess.run([adb, 'kill-server'], timeout=10, capture_output=True)
    except (subprocess.SubprocessError, OSError):
        pass
    if ':' in args.serial:
        run('connect', args.serial)
    run('-s', args.serial, 'get-state')

    if args.direction == 'pull':
        if run('-s', args.serial, 'shell', 'ls', REMOTE, check=False).returncode != 0:
            sys.exit('The robot has no robot.json yet. Turn on SAVE_TO_ROBOT in Panels first.')
        LOCAL.parent.mkdir(exist_ok=True)
        run('-s', args.serial, 'pull', REMOTE, str(LOCAL))
        print(f'Saved the robot\'s settings to {LOCAL}. Commit it to keep it.')
        return

    folder = REMOTE.rsplit('/', 1)[0]
    run('-s', args.serial, 'shell', 'mkdir', '-p', folder)
    run('-s', args.serial, 'push', str(LOCAL), REMOTE + '.tmp')
    run('-s', args.serial, 'shell', f'[ -f {REMOTE} ] && cp {REMOTE} {REMOTE}.bak; '
                                     f'mv {REMOTE}.tmp {REMOTE} && touch {REMOTE}')
    print('Uploaded robot.json. Press INIT to use it.')


if __name__ == '__main__':
    main()
